{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planner",
  "version": "0.1.0",
  "identifier": "com.planner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @planner/desktop",
    "beforeBuildCommand": "npm run build -w @planner/desktop",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Planner",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}